[Unit]
Description=mozaproxy - Linux wheel input and force-feedback relay
Documentation=https://github.com/C-Nucifora/mozaproxy
After=graphical-session.target

[Service]
Type=simple
# install.sh --service replaces @CHECKOUT@ with the quoted checkout path.
# Start manually while validating games; the native profile preserves inputs.
ExecStart="@CHECKOUT@/.venv/bin/python" "@CHECKOUT@/mozaproxy.py" --profile native
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
